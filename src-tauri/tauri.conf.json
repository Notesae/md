{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MD",
  "version": "0.1.2",
  "identifier": "io.notesae.mdreader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "快速、舒适的本地 Markdown 阅读器",
    "category": "Utility",
    "fileAssociations": [{ "ext": ["md", "markdown", "mdown"], "name": "Markdown 文档", "role": "Viewer" }],
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"], "displayLanguageSelector": false, "installerHooks": "windows/hooks.nsh" } }
  }
}
